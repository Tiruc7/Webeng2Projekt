<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="02-seed-test-data" author="team">
        <!-- If User 1 or 2 already exist, Changeset skip -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM users WHERE id IN (1, 2)</sqlCheck>
        </preConditions>

        <!-- 2 Testuser -->
        <insert tableName="users">
            <column name="id" value="1"/>
            <column name="external_id" value="test-external-id-alice"/>
            <column name="username" value="alice"/>
        </insert>
        <insert tableName="users">
            <column name="id" value="2"/>
            <column name="external_id" value="test-external-id-bob"/>
            <column name="username" value="bob"/>
        </insert>
    </changeSet>

