    <changeSet id="03-seed-user-events" author="team">
        <!-- If user_events 1-6 already exist, skip -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM user_events WHERE id IN (1, 2, 3, 4, 5, 6)</sqlCheck>
        </preConditions>

        <!-- Alice gets 3 Events -->
        <insert tableName="user_events">
            <column name="id" value="1"/>
