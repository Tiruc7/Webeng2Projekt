<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="02-01-add-venue" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="venue"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="venue" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-02-add-city" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="city"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="city" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-03-add-date" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="date"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="date" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-04-add-time" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="time"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="time" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-05-add-image-url" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="image_url"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="image_url" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-06-add-ticket-url" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="ticket_url"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="ticket_url" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="02-07-add-status" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="events" columnName="status"/>
            </not>
        </preConditions>
        <addColumn tableName="events">
            <column name="status" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>